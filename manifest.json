{
  "manifest_version": 3,
  "name": "复制当前网址",
  "version": "1.0.0",
  "description": "点击工具栏图标，当前标签页的网址立即写入剪贴板。没有弹窗、没有菜单、没有确认。",
  "minimum_chrome_version": "116",
  "permissions": ["tabs", "clipboardWrite", "offscreen"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "复制当前网址",
    "default_icon": {
      "16": "icons/icon-16.png",
      "24": "icons/icon-24.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "24": "icons/icon-24.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
